{
  "note": "Shared cases for the KanizuGIS model tools. Both pyrevit/KanizuGIS.extension/tests/test_conformance.py and tests/RevitGeoSuite.FloorPlanExport.Core.Tests/GisTools/GisToolsConformanceTests.cs read this file, so a rule changed in one implementation and not the other fails a test. Delete with the pyRevit extension (M4).",
  "audit": [
    {
      "name": "a model on the standard is clean",
      "model": { "base": "standard" },
      "expected": []
    },
    {
      "name": "never set up",
      "model": { "base": "standard", "standard_version": "" },
      "expected": [ ["warning", "standard", []] ]
    },
    {
      "name": "version is not a number",
      "model": { "base": "standard", "standard_version": "v1" },
      "expected": [ ["error", "standard", []] ]
    },
    {
      "name": "parameters: missing, legacy GUID, wrong binding",
      "model": {
        "base": "standard",
        "bound_skip": ["gis_kind", "name", "gis_category"],
        "bound_extra": [
          { "name": "name", "guid": null, "binding": "instance", "categories": ["OST_Floors"] },
          { "name": "gis_category", "guid": "standard", "binding": "instance", "categories": ["OST_Floors"] }
        ]
      },
      "expected": [ ["warning", "parameters", []], ["warning", "parameters", []], ["info", "parameters", []] ]
    },
    {
      "name": "floor types, floors, levels and families together",
      "model": {
        "base": "standard",
        "floor_types_extra": [
          { "id": 1, "name": "j 改札内コンコース_床", "floor_ids": [11, 12] },
          { "id": 2, "name": "j 謎_床", "gis_category": "concourse", "floor_ids": [13] },
          { "id": 3, "name": "j 未使用_床", "floor_ids": [] },
          { "id": 4, "name": "j 東口通路_床", "gis_category": " Walkway ", "floor_ids": [14] }
        ],
        "floors": [
          { "id": 5, "type_id": 200, "category": "lobby" },
          { "id": 6, "type_id": 200, "category": "hall" },
          { "id": 7, "type_id": 200, "category": " Retail " }
        ],
        "levels": [
          { "id": 31, "name": "ルミネ2_3FL", "ordinal": null, "short_name": "3F" },
          { "id": 32, "name": "B1FL", "ordinal": -1, "short_name": "" },
          { "id": 33, "name": "Roof", "ordinal": null, "short_name": "", "has_floors": false }
        ],
        "family_types": [
          { "id": 41, "family": "j エスカレータ-lightweight", "type": "S1000", "instance_ids": [21] },
          { "id": 42, "family": "Moving Walkway", "type": "Type 1", "instance_ids": [22] },
          { "id": 43, "family": "j エスカレーター-lightweight", "type": "S1000", "gis_kind": "Escalator", "instance_ids": [23] },
          { "id": 44, "family": "Bench", "type": "1800", "instance_ids": [24] },
          { "id": 45, "family": "Lift", "type": "A", "gis_kind": "lift", "instance_ids": [25] },
          { "id": 46, "family": "j エスカレータ-other", "type": "S800", "gis_category": "escalator", "instance_ids": [26] },
          { "id": 47, "family": "自動改札機", "type": "標準", "instance_ids": [27] },
          { "id": 48, "family": "ELEVATOR 11人乗", "type": "A", "instance_ids": [28] }
        ]
      },
      "expected": [
        ["error", "floor types", [13]],
        ["error", "floors", [6]],
        ["error", "families", [25]],
        ["warning", "floor types", [11, 12]],
        ["warning", "levels", [31]],
        ["warning", "levels", [32]],
        ["warning", "families", [21]],
        ["warning", "families", [22]],
        ["warning", "families", [27]],
        ["warning", "families", [28]]
      ]
    },
    {
      "name": "no level has an ordinal",
      "model": {
        "base": "standard",
        "levels": [
          { "id": 1, "name": "1FL", "ordinal": null, "short_name": "1F" },
          { "id": 2, "name": "B1FL", "ordinal": null, "short_name": "B1" },
          { "id": 3, "name": "Roof", "ordinal": null, "short_name": "", "has_floors": false }
        ]
      },
      "expected": [
        ["warning", "levels", [1]],
        ["warning", "levels", [2]],
        ["warning", "levels", [1, 2]]
      ]
    }
  ],
  "floor_type_match": [
    { "name": "j 改札内コンコース_床", "expected": ["j ラチ内コンコース_床", "rachi_nai", "words in the name"] },
    { "name": "j 改札外通路コンコース_床", "expected": ["j ラチ外コンコース_床", "rachi_gai", "words in the name"] },
    { "name": "j 新幹線ホーム(JR東)_床", "expected": ["j 新幹線ホーム_床", "rachi_nai", "words in the name"] },
    { "name": "j 在来線ホーム_床", "expected": ["j ホーム_床", "rachi_nai", "words in the name"] },
