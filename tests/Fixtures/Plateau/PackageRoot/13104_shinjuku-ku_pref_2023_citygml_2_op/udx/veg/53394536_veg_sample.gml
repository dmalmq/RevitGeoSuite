<?xml version="1.0" encoding="UTF-8"?>
<core:CityModel xmlns:core="http://www.opengis.net/citygml/2.0"
                xmlns:gml="http://www.opengis.net/gml"
                xmlns:veg="http://www.opengis.net/citygml/vegetation/2.0"
                gml:id="folder-veg-sample"
                srsName="urn:ogc:def:crs:EPSG::6677">
  <core:cityObjectMember>
    <veg:SolitaryVegetationObject gml:id="veg-folder-001">
      <gml:name>Folder Tree Cluster</gml:name>
      <veg:lod1Geometry>
        <gml:MultiSurface>
          <gml:surfaceMember>
            <gml:Polygon gml:id="veg-poly-001">
              <gml:exterior>
                <gml:LinearRing>
                  <gml:posList srsDimension="3">80 220 0 105 220 0 105 245 0 80 245 0 80 220 0</gml:posList>
                </gml:LinearRing>
              </gml:exterior>
            </gml:Polygon>
          </gml:surfaceMember>
        </gml:MultiSurface>
      </veg:lod1Geometry>
    </veg:SolitaryVegetationObject>
  </core:cityObjectMember>
</core:CityModel>
