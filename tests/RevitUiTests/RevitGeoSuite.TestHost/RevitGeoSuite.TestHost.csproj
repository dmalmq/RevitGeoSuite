<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Test-only Revit add-in for driving RevitGeoSuite on the build PC (see ..\README.md).
    It is never shipped: it builds to bin\Tests\, not bin\Deploy\, and no installer references it.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>RevitGeoSuite.TestHost</AssemblyName>
    <RootNamespace>RevitGeoSuite.TestHost</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Drawing" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <!-- The installer packs bin\Deploy\; test code must never land there. -->
  <Target Name="KeepOutOfDeploy" BeforeTargets="Build">
    <Error Condition="$([System.String]::Copy('$(OutputPath)').Contains('Deploy'))" Text="$(MSBuildProjectName) is test code and must not build into $(OutputPath), which the installer packs." />
  </Target>
</Project>
