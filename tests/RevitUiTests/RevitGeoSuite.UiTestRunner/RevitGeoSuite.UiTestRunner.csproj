<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Drives RevitGeoSuite in a running Revit on the build PC: the page through WebView2's DevTools
    protocol (Playwright), Revit through the test host's named pipe. See ..\README.md.
    Build-PC tool only: not part of the add-in or the installer.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RevitGeoSuite.UiTestRunner</AssemblyName>
    <RootNamespace>RevitGeoSuite.UiTestRunner</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Playwright only attaches to Revit's own WebView2; no browser is ever downloaded. -->
    <PlaywrightPlatform>win</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RevitGeoSuite.UiTestRunner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Fixtures\Conformance\gis-drift\8d7f3c1e-0000.gis-drift.json" Link="fixtures\other-model.gis-drift.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
