<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <AssemblyName>RevitGeoSuite.Shell</AssemblyName>
    <RootNamespace>RevitGeoSuite.Shell</RootNamespace>
    <!-- Product version surfaced by the installer (build-installer.ps1 reads Shell.dll's FileVersion). -->
    <Version>1.2.0</Version>
    <InformationalVersion>1.2.0</InformationalVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="RevitGeoSuite.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>RevitGeoSuite.addin</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitGeoSuite.Core\RevitGeoSuite.Core.csproj" />
    <ProjectReference Include="..\RevitGeoSuite.SharedUI\RevitGeoSuite.SharedUI.csproj" />
    <ProjectReference Include="..\RevitGeoSuite.Georeference\RevitGeoSuite.Georeference.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.MeshInspector\RevitGeoSuite.MeshInspector.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.Validation\RevitGeoSuite.Validation.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.PlateauImport\RevitGeoSuite.PlateauImport.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.Tiles3DExport\RevitGeoSuite.Tiles3DExport.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.CityGmlExport\RevitGeoSuite.CityGmlExport.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.FloorPlanExport\RevitGeoSuite.FloorPlanExport.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.FloorPlanExport.Core\RevitGeoSuite.FloorPlanExport.Core.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.CesiumHandoff\RevitGeoSuite.CesiumHandoff.csproj" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
</Project>
