<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Build-time tool: target net8.0 (overriding the repo-wide net48) so it can use
         NullabilityInfoContext to emit correct TS optionality. Loads the net48 Contracts DLL
         (pure DTOs) via reflection. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RevitGeoSuite.SharedUI.Web.Contracts.Generator</RootNamespace>
    <AssemblyName>RevitGeoSuite.SharedUI.Web.Contracts.Generator</AssemblyName>
  </PropertyGroup>

</Project>
