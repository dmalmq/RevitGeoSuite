<Window x:Class="RevitGeoSuite.Validation.ValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:coreValidation="clr-namespace:RevitGeoSuite.Core.Validation;assembly=RevitGeoSuite.Core"
        xmlns:loc="clr-namespace:RevitGeoSuite.SharedUI.Localization;assembly=RevitGeoSuite.SharedUI"
        xmlns:shared="clr-namespace:RevitGeoSuite.SharedUI.Controls;assembly=RevitGeoSuite.SharedUI"
        Title="Check Project"
        Height="800"
        Width="1180"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RevitGeoSuite.SharedUI;component/Styles/SuiteTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="94" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <shared:ModuleNavRailControl x:Name="ModuleNavRail" Grid.RowSpan="3" CurrentModuleKey="Validation" />

    <Border Grid.Column="1" Style="{StaticResource ShellHeaderBorderStyle}">
      <DockPanel>
        <shared:LanguageToggleControl DockPanel.Dock="Right" />
        <StackPanel Margin="0,0,18,0">
          <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[App.ProductTitle]}" />
          <TextBlock Margin="0,6,0,0" Style="{StaticResource WindowTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Module.Validation]}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding DocumentTitle}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Validation.Header]}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource ShellCardBorderStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Validation.Center.Health]}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource SectionTitleTextStyle}" Text="{Binding StatusTitle}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding StatusMessage}" />
          </StackPanel>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource ShellCardBorderStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Validation.Center.Findings]}" />
              <TextBlock Margin="0,8,0,14" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Validation.FindingsHint]}" />
              <ItemsControl ItemsSource="{Binding Findings}" Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type coreValidation:ValidationResult}">
                    <Border Padding="12" Margin="0,0,0,10" CornerRadius="8" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource SuiteWarningSurfaceBrush}" />
                          <Setter Property="BorderBrush" Value="{StaticResource SuiteWarningBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                              <Setter Property="Background" Value="{StaticResource SuiteSuccessSurfaceBrush}" />
                              <Setter Property="BorderBrush" Value="{StaticResource SuiteSuccessBorderBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Severity}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Message}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Validation.NoFindings]}" Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource ShellCardBorderStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Validation.Center.Readiness]}" />
              <TextBlock Margin="0,8,0,0" Style="{StaticResource CardTitleTextStyle}" Text="{Binding ExportReadinessTitle}" />
              <TextBlock Margin="0,6,0,14" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding ExportReadinessMessage}" />
              <ItemsControl ItemsSource="{Binding ExportReadinessItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="12" Margin="0,0,0,10" CornerRadius="8" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource SuiteWarningSurfaceBrush}" />
                          <Setter Property="BorderBrush" Value="{StaticResource SuiteWarningBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSatisfied}" Value="True">
                              <Setter Property="Background" Value="{StaticResource SuiteSuccessSurfaceBrush}" />
                              <Setter Property="BorderBrush" Value="{StaticResource SuiteSuccessBorderBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Title}" />
                        <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding StatusText}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource SuiteWarningBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSatisfied}" Value="True">
                                  <Setter Property="Foreground" Value="#2D7A5F" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Detail}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource ShellCardBorderStyle}">
          <Expander IsExpanded="False">
            <Expander.Header>
              <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Validation.Sidebar.Snapshot]}" />
            </Expander.Header>
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding DetailRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="200" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource SummaryRowValueStyle}" Text="{Binding Value}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FooterBarBorderStyle}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.Close]}" Click="OnCloseClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
