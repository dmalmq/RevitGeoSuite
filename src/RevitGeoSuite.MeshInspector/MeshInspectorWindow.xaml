<Window x:Class="RevitGeoSuite.MeshInspector.MeshInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RevitGeoSuite.SharedUI.Localization;assembly=RevitGeoSuite.SharedUI"
        xmlns:shared="clr-namespace:RevitGeoSuite.SharedUI.Controls;assembly=RevitGeoSuite.SharedUI"
        Title="Mesh Inspector"
        Height="860"
        Width="1360"
        MinWidth="1100"
        MinHeight="740"
        Loaded="OnLoaded"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RevitGeoSuite.SharedUI;component/Styles/SuiteTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="94" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <shared:ModuleNavRailControl x:Name="ModuleNavRail" Grid.RowSpan="3" CurrentModuleKey="MeshInspector" />

    <Border Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ShellHeaderBorderStyle}">
      <DockPanel>
        <shared:LanguageToggleControl DockPanel.Dock="Right" />
        <StackPanel Margin="0,0,18,0">
          <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[App.ProductTitle]}" />
          <TextBlock Margin="0,6,0,0" Style="{StaticResource WindowTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Module.MeshInspector]}" />
          <TextBlock Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding WindowTitle}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding DocumentTitle}" />
          <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Mesh.Header]}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource WarningBorderStyle}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SuccessBorderStyle}" Visibility="{Binding HasActionMessage, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap" />
      </Border>

      <Grid Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="Reference Source" />
            <ComboBox Margin="0,8,12,0"
                      ItemsSource="{Binding ReferenceSourceOptions}"
                      SelectedItem="{Binding SelectedReferenceSourceOption, Mode=TwoWay}"
                      DisplayMemberPath="Title"
                      SelectionChanged="OnReferenceSourceSelectionChanged" />
          </StackPanel>
          <TextBlock Grid.Column="1" Margin="0,26,16,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding ReferenceSourceDescription}" />
          <Border Grid.Column="2" Style="{StaticResource ShellCardBorderStyle}" Padding="16" Margin="0">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding ReferenceSourceTitle}" />
              <TextBlock Margin="0,8,0,0" Style="{StaticResource MetricTextStyle}" Text="{Binding PrimaryMeshCode}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ShellCardBorderStyle}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="18,18,18,0">
              <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Mesh.Center.Map]}" />
              <TextBlock Margin="0,8,0,12" Style="{StaticResource BodyMutedTextStyle}" Text="The selected cell is highlighted on the shared map. Neighbor cells give quick context without forcing you to leave the mesh workflow." />
            </StackPanel>
            <shared:MapControl Grid.Row="1" x:Name="MeshMap" Margin="18,0,18,18" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ShellDetailsPanelBorderStyle}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource StatusPillBorderStyle}">
            <TextBlock FontWeight="SemiBold" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Shell.RightPanel]}" />
          </Border>

          <Expander IsExpanded="True">
            <Expander.Header>
              <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Mesh.Sidebar.Reference]}" />
            </Expander.Header>
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding DetailRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource SummaryRowValueStyle}" Text="{Binding Value}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <Expander IsExpanded="True">
            <Expander.Header>
              <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Mesh.Center.Neighbors]}" />
            </Expander.Header>
            <StackPanel Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding NeighborMeshCodes}" Visibility="{Binding HasNeighborMeshCodes, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipBorderStyle}">
                      <TextBlock FontFamily="Consolas" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="Neighbor meshes are not available until the selected reference can be resolved." Visibility="{Binding HasNoNeighborMeshCodes, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
          </Expander>

          <Expander IsExpanded="False">
            <Expander.Header>
              <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Mesh.Sidebar.Details]}" />
            </Expander.Header>
            <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="Saving is only available when the reference source is Survey Point / Canonical Origin. Project Base Point mode stays read-only so the canonical mesh key remains stable." />
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FooterBarBorderStyle}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.CopyMesh]}" Click="OnCopyPrimaryMeshClick" IsEnabled="{Binding CanCopyPrimaryMeshCode}" />
        <Button Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.SaveCanonicalMesh]}" Click="OnSavePrimaryMeshClick" IsEnabled="{Binding CanSavePrimaryMeshCode}" />
        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.Close]}" Click="OnCloseClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>




