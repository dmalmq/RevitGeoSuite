<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <RootNamespace>RevitGeoSuite.PlateauImport</RootNamespace>
    <AssemblyName>RevitGeoSuite.PlateauImport</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitGeoSuite.Core\RevitGeoSuite.Core.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.Core.Plateau\RevitGeoSuite.Core.Plateau.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.RevitInterop\RevitGeoSuite.RevitInterop.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.SharedUI\RevitGeoSuite.SharedUI.csproj" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.5.0" GeneratePathProperty="true" />
    <PackageReference Include="NetTopologySuite.Features" Version="2.2.0" GeneratePathProperty="true" />
    <PackageReference Include="NetTopologySuite.IO.Esri.Shapefile" Version="1.2.0" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyNetTopologySuiteToOutput" AfterTargets="Build">
    <Copy
      SourceFiles="$(PkgNetTopologySuite)\lib\netstandard2.0\NetTopologySuite.dll"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(PkgNetTopologySuite)\lib\netstandard2.0\NetTopologySuite.dll')" />
    <Copy
      SourceFiles="$(PkgNetTopologySuite_Features)\lib\netstandard2.0\NetTopologySuite.Features.dll"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(PkgNetTopologySuite_Features)\lib\netstandard2.0\NetTopologySuite.Features.dll')" />
    <Copy
      SourceFiles="$(PkgNetTopologySuite_IO_Esri_Shapefile)\lib\netstandard2.0\NetTopologySuite.IO.Esri.Shapefile.dll"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(PkgNetTopologySuite_IO_Esri_Shapefile)\lib\netstandard2.0\NetTopologySuite.IO.Esri.Shapefile.dll')" />
  </Target>
</Project>
