<Window x:Class="RevitGeoSuite.PlateauImport.Online.PlateauOnlineImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sharedUi="clr-namespace:RevitGeoSuite.SharedUI.Controls;assembly=RevitGeoSuite.SharedUI"
        Title="Import PLATEAU Online"
        Height="780"
        Width="1100"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitGeoSuite.SharedUI;component/Styles/SuiteTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Import PLATEAU Online" />
            <TextBlock Margin="0,4,0,0" Text="Pick a Japanese municipality, choose an output mode, and import 3D Tiles as Revit DirectShape geometry." TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="14" Margin="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Search prefecture or municipality" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                <TextBlock Text="Try 'Tokyo', '東京', 'Shinjuku', '新宿', or a municipal code like '13104'." Foreground="#888888" FontSize="11" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding FilteredSearchResults}" SelectedItem="{Binding SelectedSearchOption, Mode=TwoWay}" Height="320" Margin="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayLabel}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding CodeLabel}" Foreground="#888888" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Geometry mode" FontWeight="SemiBold" Margin="0,0,0,4" />
                <RadioButton x:Name="ModeLod2Radio" GroupName="Mode" Content="LOD2 buildings without texture" IsChecked="True" Margin="0,0,0,4" Checked="OnModeChanged" />
                <RadioButton x:Name="ModeFootprintDxfRadio" GroupName="Mode" Content="Lightweight footprint DXF (no Revit elements)" Checked="OnModeChanged" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="8,0,0,0">
            <sharedUi:MapControl x:Name="AreaMap" />
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ProgressBar Height="14" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" Margin="0,8,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <StackPanel>
                <TextBlock Text="Warnings" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Warnings}" Height="100" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Close" Width="100" Height="32" Click="OnCancelClick" />
            <Button x:Name="ImportButton" Content="Download &amp; Import" Width="170" Height="32" Margin="8,0,0,0" Click="OnImportClick" />
        </StackPanel>
    </Grid>
</Window>
