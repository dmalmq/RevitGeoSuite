<Window x:Class="RevitGeoSuite.Georeference.GeoreferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:RevitGeoSuite.SharedUI.Controls;assembly=RevitGeoSuite.SharedUI"
        xmlns:loc="clr-namespace:RevitGeoSuite.SharedUI.Localization;assembly=RevitGeoSuite.SharedUI"
        Title="Georeference Setup"
        Height="760"
        Width="1280"
        MinWidth="1080"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RevitGeoSuite.SharedUI;component/Styles/SuiteTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="94" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <shared:ModuleNavRailControl x:Name="ModuleNavRail" Grid.RowSpan="3" CurrentModuleKey="Georeference" />

    <Border Grid.Column="1" Style="{StaticResource ShellHeaderBorderStyle}">
      <DockPanel>
        <shared:LanguageToggleControl DockPanel.Dock="Right" />
        <StackPanel Margin="0,0,18,0">
          <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[App.ProductTitle]}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource WindowTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Module.Georeference]}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding CurrentStateSummary}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <Border Style="{StaticResource WarningBorderStyle}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource WarningBorderStyle}" Visibility="{Binding HasExistingSetupMessage, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding ExistingSetupMessage}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource ShellCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <shared:CrsPickerControl AvailableDefinitions="{Binding AvailableCrs}" SelectedDefinition="{Binding SelectedCrs, Mode=TwoWay}" />

              <CheckBox Margin="0,16,0,0"
                        Content="{Binding OverrideExistingSetupLabel}"
                        IsChecked="{Binding OverrideExistingSetup, Mode=TwoWay}"
                        Visibility="{Binding HasDetectedExistingPointSetup, Converter={StaticResource BoolToVisibilityConverter}}" />

              <!-- Existing setup confirm -->
              <StackPanel Margin="0,16,0,0" Visibility="{Binding IsConfirmExistingSetupMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <CheckBox Content="{Binding ExistingSetupConfirmationLabel}"
                          IsChecked="{Binding ConfirmExistingSetup, Mode=TwoWay}" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding ExistingSetupConfirmationHint}" TextWrapping="Wrap" />
              </StackPanel>

              <!-- New project inputs -->
              <StackPanel Margin="0,16,0,0" Visibility="{Binding IsNewProjectMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Georef.QuickSetup.EastingLabel]}" />
                    <TextBox Margin="0,6,0,0" Text="{Binding ProjectBasePointOffsetXInput, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Georef.QuickSetup.NorthingLabel]}" />
                    <TextBox Margin="0,6,0,0" Text="{Binding ProjectBasePointOffsetYInput, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <Border Margin="0,14,0,0" Style="{StaticResource WarningBorderStyle}" Visibility="{Binding HasSetupValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding SetupValidationMessage}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>

            <Border Grid.Column="2" Width="640" Visibility="{Binding IsNewProjectMode, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel>
                <Border Style="{StaticResource WarningBorderStyle}" Visibility="{Binding HasPlateauGridUnavailableMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                  <TextBlock Text="{Binding PlateauGridUnavailableMessage}" TextWrapping="Wrap" />
                </Border>

                <shared:MapControl x:Name="PlateauGridMap" Height="360" />

                <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding PlateauGridStatusText}" TextWrapping="Wrap" />

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource SummaryRowValueStyle}" Text="{Binding PlateauGridAnchorSummary}" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.Clear]}" Click="OnClearPlateauGridSelectionClick" IsEnabled="{Binding CanClearPlateauGridSelection}" />
                </Grid>

                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Visibility="{Binding HasPlateauGridOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                  <ItemsControl ItemsSource="{Binding PlateauGridOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="8" Background="#FAFAF6" BorderBrush="{StaticResource SuiteBorderBrush}" BorderThickness="1" CornerRadius="5">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel>
                              <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text="{Binding Title}" />
                              <TextBlock Margin="0,2,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Description}" TextWrapping="Wrap" />
                            </StackPanel>
                          </CheckBox>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <TextBlock Margin="2,4,2,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Georef.Action.ApplyManual]}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FooterBarBorderStyle}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.Apply]}" Click="OnApplyClick" IsEnabled="{Binding CanApply}" />
        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.Close]}" Click="OnCloseClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
