<Window x:Class="RevitGeoSuite.CityGmlExport.CityGmlExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RevitGeoSuite.SharedUI.Localization;assembly=RevitGeoSuite.SharedUI"
        xmlns:shared="clr-namespace:RevitGeoSuite.SharedUI.Controls;assembly=RevitGeoSuite.SharedUI"
        Title="CityGML Export"
        Height="880"
        Width="1240"
        MinWidth="1040"
        MinHeight="740"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </Window.Resources>

  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="94" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <shared:ModuleNavRailControl x:Name="ModuleNavRail" Grid.RowSpan="3" CurrentModuleKey="CityGmlExport" />

    <Border Grid.Column="1" Style="{StaticResource ShellHeaderBorderStyle}">
      <DockPanel>
        <shared:LanguageToggleControl DockPanel.Dock="Right" />
        <StackPanel Margin="0,0,18,0">
          <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[App.ProductTitle]}" />
          <TextBlock Margin="0,6,0,0" Style="{StaticResource WindowTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Module.CityGmlExport]}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding DocumentTitle}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.Header]}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource WarningBorderStyle}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource SuccessBorderStyle}" Visibility="{Binding HasActionMessage, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource ShellCardBorderStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.OutputFolder]}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="118" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.Browse]}" Click="OnBrowseOutputClick" />
            </Grid>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.OutputHint]}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource ShellCardBorderStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.Center.Scope]}" />
            <TextBlock Margin="0,8,0,16" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.ScopeHint]}" />

            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.VisibleExportView]}" />
            <ComboBox Margin="0,8,0,0"
                      ItemsSource="{Binding AvailableViewOptions}"
                      SelectedItem="{Binding SelectedViewOption, Mode=TwoWay}"
                      DisplayMemberPath="Title"
                      Visibility="{Binding HasAvailableViews, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding SelectedViewDescription}" />
            <TextBlock Margin="0,8,0,0" Foreground="#8A2D2D" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.NoView]}" Visibility="{Binding HasNoAvailableViews, Converter={StaticResource BoolToVisibilityConverter}}" TextWrapping="Wrap" />

            <Expander Margin="0,18,0,0" IsExpanded="True">
              <Expander.Header>
                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.IncludeLinks]}" />
              </Expander.Header>
              <StackPanel Margin="0,10,0,0">
                <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.IncludeLinksHint]}" />
                <ScrollViewer Margin="0,10,0,0" MaxHeight="220" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasLinkedModelOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                  <ItemsControl ItemsSource="{Binding LinkedModelOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource ShellCardBorderStyle}" Padding="12" Margin="0,0,0,10">
                          <StackPanel>
                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            <TextBlock Margin="20,6,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Description}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.NoLinks]}" Visibility="{Binding HasNoLinkedModelOptions, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding LinkedModelSummary}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource ShellCardBorderStyle}">
          <Expander IsExpanded="False">
            <Expander.Header>
              <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.Sidebar.Reference]}" />
            </Expander.Header>
            <StackPanel Margin="0,12,0,0">
              <ComboBox ItemsSource="{Binding ReferenceSourceOptions}"
                        SelectedItem="{Binding SelectedReferenceSourceOption, Mode=TwoWay}"
                        DisplayMemberPath="Title" />
              <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding ReferenceSourceTitle}" />
              <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding ReferenceSourceDescription}" />
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding CurrentStateRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource SummaryRowValueStyle}" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
        </Border>

        <Border Style="{StaticResource ShellCardBorderStyle}">
          <Expander IsExpanded="False">
            <Expander.Header>
              <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.Sidebar.Advanced]}" />
            </Expander.Header>
            <StackPanel Margin="0,12,0,0">
              <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.TargetProfile]}" />
              <ComboBox Margin="0,8,0,0"
                        ItemsSource="{Binding SchemaVersionOptions}"
                        SelectedItem="{Binding SelectedSchemaVersionOption, Mode=TwoWay}"
                        DisplayMemberPath="Title" />
              <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding SelectedSchemaVersionOption.Description}" />

              <Expander Margin="0,16,0,0" IsExpanded="False">
                <Expander.Header>
                  <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.CodelistOverrides]}" />
                </Expander.Header>
                <StackPanel Margin="0,12,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.BuildingFunctionCode]}" />
                      <TextBox Margin="0,4,0,0" Text="{Binding BuildingCodeOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.RoadFunctionCode]}" />
                      <TextBox Margin="0,4,0,0" Text="{Binding RoadCodeOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.VegetationFunctionCode]}" />
                      <TextBox Margin="0,4,0,0" Text="{Binding VegetationCodeOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.CodelistHint]}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Expander>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource ShellCardBorderStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.Center.Prepared]}" />
              <TextBlock Margin="0,8,0,14" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.PreparedHint]}" />
              <ItemsControl ItemsSource="{Binding PreparedRows}" Visibility="{Binding HasPreparedRows, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource SummaryRowValueStyle}" Text="{Binding Value}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.NoPrepared]}" Visibility="{Binding HasNoPreparedRows, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource ShellCardBorderStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.Center.Validation]}" />
              <TextBlock Margin="0,8,0,14" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.ValidationHint]}" />
              <ItemsControl ItemsSource="{Binding ValidationMessages}" Visibility="{Binding HasValidationMessages, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource WarningBorderStyle}" Margin="0,0,0,10">
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.NoValidation]}" Visibility="{Binding HasNoValidationMessages, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource ShellCardBorderStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.Center.Features]}" />
            <TextBlock Margin="0,8,0,14" Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.FeaturesHint]}" />
            <ItemsControl ItemsSource="{Binding FeatureNames}" Visibility="{Binding HasFeatureNames, Converter={StaticResource BoolToVisibilityConverter}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ShellCardBorderStyle}" Padding="12" Margin="0,0,0,10">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.NoFeatures]}" Visibility="{Binding HasNoFeatureNames, Converter={StaticResource BoolToVisibilityConverter}}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource ShellCardBorderStyle}">
          <Expander IsExpanded="False">
            <Expander.Header>
              <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.Sidebar.LastExport]}" />
            </Expander.Header>
            <StackPanel Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding LastExportRows}" Visibility="{Binding HasLastExportRows, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource SummaryRowValueStyle}" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[City.NoLastExport]}" Visibility="{Binding HasNoLastExportRows, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
          </Expander>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FooterBarBorderStyle}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.PrepareExport]}" Click="OnPrepareClick" IsEnabled="{Binding CanPrepareExport}" />
        <Button Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.ExportCityGml]}" Click="OnExportClick" IsEnabled="{Binding CanExport}" />
        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Common.Close]}" Click="OnCloseClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
