<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <RootNamespace>RevitGeoSuite.SharedUI</RootNamespace>
    <AssemblyName>RevitGeoSuite.SharedUI</AssemblyName>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);web-contracts\**;web-contracts-generator\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitGeoSuite.Core\RevitGeoSuite.Core.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RevitGeoSuite.SharedUI.Web.Contracts\RevitGeoSuite.SharedUI.Web.Contracts.csproj" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- The Vite bundle uses content-hashed filenames that change between builds, so it can't be a
       static <EmbeddedResource> glob (which MSBuild evaluates before BuildWebAssets regenerates
       dist). Add it after the web build runs but before resource names are assigned, so the
       freshly built files are the ones embedded (with the usual project-relative manifest names). -->
  <Target Name="IncludeWebAssets" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <EmbeddedResource Include="Resources\Web\dist\**\*" Condition="Exists('Resources\Web\dist')" />
    </ItemGroup>
  </Target>

  <Import Project="build\RevitGeoSuite.SharedUI.Web.targets" />

  <Target Name="CopyReferenceAssembliesToCommonOutput" AfterTargets="Build">
    <Copy
      SourceFiles="@(ReferenceCopyLocalPaths)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="'@(ReferenceCopyLocalPaths)' != ''" />
  </Target>
</Project>
