<UserControl x:Class="RevitGeoSuite.SharedUI.Controls.LanguageToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RevitGeoSuite.SharedUI.Localization">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RevitGeoSuite.SharedUI;component/Styles/SuiteTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border Background="Transparent"
          BorderBrush="{StaticResource SuiteBorderBrush}"
          BorderThickness="1"
          CornerRadius="6">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="60" />
        <ColumnDefinition Width="60" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Margin="0"
              Padding="10,7"
              Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Language.English]}"
              Click="OnEnglishClick"
              IsEnabled="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=CanSwitchToEnglish}" />
      <Button Grid.Column="1"
              Margin="0"
              Padding="10,7"
              Style="{StaticResource SecondaryButtonStyle}"
              Content="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=[Language.Japanese]}"
              Click="OnJapaneseClick"
              IsEnabled="{Binding Source={x:Static loc:UiLocalizer.Instance}, Path=CanSwitchToJapanese}" />
    </Grid>
  </Border>
</UserControl>
