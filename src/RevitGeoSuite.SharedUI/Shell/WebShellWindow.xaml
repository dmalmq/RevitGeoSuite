<Window x:Class="RevitGeoSuite.SharedUI.Shell.WebShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RevitGeoSuite"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        Background="#E9EEEC">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Grid>
        <wv2:WebView2 x:Name="ShellBrowser" />
        <Border x:Name="FallbackOverlay"
                Background="#E9EEEC"
                TextElement.FontFamily="Yu Gothic UI, Segoe UI"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="520">
                <TextBlock x:Name="FallbackTitle"
                           Text="WebView2 initialization failed"
                           Foreground="#B42318"
                           FontSize="18"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="FallbackMessage"
                           Foreground="#56605C"
                           FontSize="14"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Name="DownloadRuntimeButton"
                        Content="Download WebView2 Runtime"
                        Margin="0,20,0,0"
                        Padding="16,8"
                        HorizontalAlignment="Center"
                        Background="#1D5E51"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="DownloadRuntimeButton_Click" />
                <TextBlock x:Name="DownloadHint"
                           Text="Opens the Microsoft download page in your browser."
                           Foreground="#56605C"
                           FontSize="11"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
