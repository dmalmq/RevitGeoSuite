<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="SuiteInkColor">#1E2832</Color>
  <Color x:Key="SuitePaperColor">#F3EFE7</Color>
  <Color x:Key="SuiteCanvasColor">#FBF8F1</Color>
  <Color x:Key="SuitePanelColor">#FFFDF8</Color>
  <Color x:Key="SuiteNavColor">#17323B</Color>
  <Color x:Key="SuiteAccentColor">#0F7B7B</Color>
  <Color x:Key="SuiteAccentSoftColor">#DCEFED</Color>
  <Color x:Key="SuiteBorderColor">#D9D1C3</Color>
  <Color x:Key="SuiteMutedColor">#64717E</Color>
  <Color x:Key="SuiteWarningColor">#8B3E2F</Color>
  <Color x:Key="SuiteWarningSurfaceColor">#FFF1EB</Color>
  <Color x:Key="SuiteSuccessSurfaceColor">#F0F9F5</Color>
  <Color x:Key="SuiteSuccessBorderColor">#B8D1C6</Color>

  <SolidColorBrush x:Key="SuiteInkBrush" Color="{StaticResource SuiteInkColor}" />
  <SolidColorBrush x:Key="SuitePaperBrush" Color="{StaticResource SuitePaperColor}" />
  <SolidColorBrush x:Key="SuiteCanvasBrush" Color="{StaticResource SuiteCanvasColor}" />
  <SolidColorBrush x:Key="SuitePanelBrush" Color="{StaticResource SuitePanelColor}" />
  <SolidColorBrush x:Key="SuiteNavBrush" Color="{StaticResource SuiteNavColor}" />
  <SolidColorBrush x:Key="SuiteAccentBrush" Color="{StaticResource SuiteAccentColor}" />
  <SolidColorBrush x:Key="SuiteAccentSoftBrush" Color="{StaticResource SuiteAccentSoftColor}" />
  <SolidColorBrush x:Key="SuiteBorderBrush" Color="{StaticResource SuiteBorderColor}" />
  <SolidColorBrush x:Key="SuiteMutedBrush" Color="{StaticResource SuiteMutedColor}" />
  <SolidColorBrush x:Key="SuiteWarningBrush" Color="{StaticResource SuiteWarningColor}" />
  <SolidColorBrush x:Key="SuiteWarningSurfaceBrush" Color="{StaticResource SuiteWarningSurfaceColor}" />
  <SolidColorBrush x:Key="SuiteSuccessSurfaceBrush" Color="{StaticResource SuiteSuccessSurfaceColor}" />
  <SolidColorBrush x:Key="SuiteSuccessBorderBrush" Color="{StaticResource SuiteSuccessBorderColor}" />
  <SolidColorBrush x:Key="SuiteNavTextBrush" Color="#EEF6F3" />

  <Thickness x:Key="ShellWindowPadding">22</Thickness>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource SuitePaperBrush}" />
    <Setter Property="Foreground" Value="{StaticResource SuiteInkBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SuiteInkBrush}" />
  </Style>

  <Style x:Key="WindowTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Bahnschrift" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SuiteInkBrush}" />
  </Style>

  <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Bahnschrift" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SuiteInkBrush}" />
  </Style>

  <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Bahnschrift" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SuiteInkBrush}" />
  </Style>

  <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SuiteMutedBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="BodyMutedTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SuiteMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="MetricTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Bahnschrift" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Background" Value="{StaticResource SuiteAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource SuiteAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="BorderBrush" Value="{StaticResource SuiteBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="White" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="BorderBrush" Value="{StaticResource SuiteBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="White" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style TargetType="Expander">
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#EDE5D7" />
    <Setter Property="Foreground" Value="{StaticResource SuiteInkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuiteBorderBrush}" />
  </Style>

  <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Background" Value="#F6F1E7" />
  </Style>

    <Style x:Key="ShellHeaderBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuitePanelBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="Margin" Value="0,0,0,14" />
    <Setter Property="BorderBrush" Value="{StaticResource SuiteBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

    <Style x:Key="ShellCardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuitePanelBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="BorderBrush" Value="{StaticResource SuiteBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

    <Style x:Key="ShellDetailsPanelBorderStyle" TargetType="Border" BasedOn="{StaticResource ShellCardBorderStyle}">
    <Setter Property="Margin" Value="14,0,0,0" />
    <Setter Property="Padding" Value="14" />
  </Style>

    <Style x:Key="FooterBarBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuitePanelBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,14,0,0" />
    <Setter Property="BorderBrush" Value="{StaticResource SuiteBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

    <Style x:Key="ShellRailBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuiteNavBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,12" />
    <Setter Property="Margin" Value="0,0,14,0" />
  </Style>

    <Style x:Key="RailNavItemBorderStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,8" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="StatusPillBorderStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="#F2F6F4" />
    <Setter Property="BorderBrush" Value="{StaticResource SuiteBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

    <Style x:Key="WarningBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuiteWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuiteWarningBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,12" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

    <Style x:Key="SuccessBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuiteSuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuiteSuccessBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,12" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

    <Style x:Key="ChipBorderStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Background" Value="#F4EFE5" />
    <Setter Property="BorderBrush" Value="{StaticResource SuiteBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="StepChipBorderStyle" TargetType="Border" BasedOn="{StaticResource ChipBorderStyle}">
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style x:Key="SummaryRowLabelStyle" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SuiteInkBrush}" />
  </Style>

  <Style x:Key="SummaryRowValueStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SuiteMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</ResourceDictionary>






